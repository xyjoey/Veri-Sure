# Copy this file to `.env` and fill in the provider you use.
#
# Veri-Sure looks for `.env` in the current directory (or a parent), then in the repository root.
# Variables already set in your shell take precedence over this file, and command-line flags
# (--provider, --model, --api-key, --base-url, --extra-body) take precedence over both.
# Leave a value empty (or commented out) to use the default.

# Which API to use: openai (OpenAI or any OpenAI-compatible server), anthropic, or gemini.
LLM_PROVIDER=openai

# --- OpenAI / OpenAI-compatible (e.g. DeepSeek, vLLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_EXTRA_BODY={"key": "value"}

# --- Anthropic (Claude) ---
# Without an API key, the Anthropic SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=
# ANTHROPIC_EXTRA_BODY={"key": "value"}
# Server-side refusal fallbacks are on by default for claude-opus-5-5 (and a few other models); set to off to disable.
# ANTHROPIC_FALLBACKS=off

# --- Google Gemini ---
# GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
# GEMINI_BASE_URL=
# GEMINI_EXTRA_BODY={"key": "value"}
